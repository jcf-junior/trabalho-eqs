    {
      "name": "Professores",
      "item": [
        {
          "name": "Create Professor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/professores",
              "host": ["{{baseUrl}}"],
              "path": ["professores"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Professor Teste\",\n  \"habilitacoes\": \"Doutoramento\",\n  \"email\": \"professor.{{runId}}@unipvc.pt\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"runId\", String(Date.now()).slice(-6));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const professor = pm.response.json();",
                  "",
                  "pm.test(\"Response contains the created professor\", function () {",
                  "    pm.expect(professor.id).to.be.a(\"number\");",
                  "    pm.expect(professor.nome).to.eql(\"Professor Teste\");",
                  "    pm.expect(professor.habilitacoes).to.eql(\"Doutoramento\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"professorId\", professor.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Created Professor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/professores/{{professorId}}",
